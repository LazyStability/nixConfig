[Install]
WantedBy=default.target

[Service]
ExecStart=/usr/bin/mpd --no-daemon
ExecStartPre=/bin/bash -c "/nix/store/hlxw2q9qansq7bn52xvlb5badw3z1v8s-coreutils-9.10/bin/mkdir -p '/home/me/.local/share/mpd' '/home/me/.local/share/mpd/playlists'"
Type=notify

[Unit]
After=network.target
After=sound.target
Description=Music Player Daemon
