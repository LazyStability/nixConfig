if [ -z "$SSH_AUTH_SOCK" -o -z "$SSH_CONNECTION" ]; then
  # export SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/ssh-agent
  # Use yubikey-agent
  export SSH_AUTH_SOCK=$XDG_RUNTIME_DIR/yubikey-agent/yubikey-agent.sock
fi

if [ -d "$HOME/.local/bin" ] ; then
    export PATH="$HOME/.local/bin:$PATH"
fi

export EDITOR="nvim"
export FZF_DEFAULT_OPTS="--color bg:#24283b,bg+:#1f2335,fg:#a9b1d6,fg+:#c0caf5,header:#41a6b5,hl:#41a6b5,hl+:#41a6b5,info:#e0af68,marker:#1abc9c,pointer:#1abc9c,prompt:#e0af68,spinner:#1abc9c"
export TERMINAL="kitty"
export GNUPGHOME="${XDG_DATA_HOME:-$HOME/.local/share}/gnupg"
export XDG_DESKTOP_DIR="$HOME/Desktop"
export XDG_DOCUMENTS_DIR="$HOME/Dokumente"
export XDG_DOWNLOAD_DIR="$HOME/Downloads"
export XDG_MUSIC_DIR="$HOME/Musik"
export XDG_PICTURES_DIR="$HOME/Bilder"
export XDG_PROJECTS_DIR="$HOME/Software"
export XDG_VIDEOS_DIR="$HOME/Videos"
